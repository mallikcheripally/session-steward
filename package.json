{
  "name": "session-steward",
  "version": "0.10.1",
  "description": "Codex and Claude Code session manager - browse, back up, and delete old sessions. Local browser UI + CLI.",
  "license": "MIT",
  "author": "Mallik Cheripally",
  "type": "module",
  "bin": {
    "session-steward": "bin/session-steward.mjs",
    "session-steward-cli": "bin/session-steward-cli.mjs",
    "session-steward-mcp": "bin/session-steward-mcp.mjs",
    "session-steward-scheduler": "bin/session-steward-scheduler.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mallikcheripally/session-steward.git"
  },
  "homepage": "https://github.com/mallikcheripally/session-steward#readme",
  "bugs": "https://github.com/mallikcheripally/session-steward/issues",
  "keywords": [
    "codex",
    "codex-cli",
    "codex-sessions",
    "codex-cleanup",
    "openai-codex",
    "chatgpt-desktop",
    "claude-code",
    "claude-code-sessions",
    "claude-code-cleanup",
    "claude-desktop",
    "session-cleanup",
    "session-history",
    "session-manager",
    "disk-space",
    "disk-cleanup"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "bin",
    "dist",
    "lib",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "benchmark:claude-discovery": "node --expose-gc test/benchmarks/claude-discovery.mjs",
    "benchmark:discovery": "node --expose-gc test/benchmarks/codex-discovery.mjs",
    "benchmark:events": "node --expose-gc test/benchmarks/session-events.mjs",
    "benchmark:overview": "node --expose-gc test/benchmarks/codex-overview.mjs",
    "benchmark:scale": "node --expose-gc test/benchmarks/codex-list.mjs",
    "benchmark:size": "node --expose-gc test/benchmarks/codex-size.mjs",
    "benchmark:tokens": "node --expose-gc test/benchmarks/session-tokens.mjs",
    "benchmark:transcripts": "node --expose-gc test/benchmarks/codex-transcripts.mjs",
    "benchmark:versioned-stores": "node --expose-gc test/benchmarks/codex-versioned-stores.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "start": "node ./bin/session-steward.mjs",
    "serve": "node ./bin/session-steward.mjs",
    "check": "node ./bin/session-steward-cli.mjs --json --limit 5",
    "test": "node --test test/*.test.mjs test/providers/*.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
